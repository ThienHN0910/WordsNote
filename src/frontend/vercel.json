{
  "rewrites": [
    {
      "source": "/api-backend/:path*",
      "destination": "http://words-note.runasp.net/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://words-note.runasp.net/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}